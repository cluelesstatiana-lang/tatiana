import React, { useEffect, useState } from "react";

const STORAGE_KEY = "anon_message_wall_messages_v1";

function saveMessages(messages) {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(messages));
  } catch (e) {
    console.error(e);
  }
}

function loadMessages() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : [];
  } catch (e) {
    console.error(e);
    return [];
  }
}

export default function AnonymousMessageWall() {
  const [messages, setMessages] = useState(() => loadMessages());
  const [name, setName] = useState("");
  const [text, setText] = useState("");
  const [isAdmin, setIsAdmin] = useState(false);
  const [passphrase, setPassphrase] = useState("");
  const [filter, setFilter] = useState("all");

  const DEMO_PASSPHRASE = "unlock";

  useEffect(() => {
    saveMessages(messages);
  }, [messages]);

  function submitMessage(e) {
    e && e.preventDefault();
    const body = text.trim();
    if (!body) return;
    const newMsg = {
      id: `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`,
      name: name.trim() || "Anonymous",
      text: body,
      createdAt: new Date().toISOString(),
      read: false,
    };
    setMessages(prev => [newMsg, ...prev]);
    setText("");
    setName("");
  }

  function tryUnlock(e) {
    e && e.preventDefault();
    if (passphrase === DEMO_PASSPHRASE) {
      setIsAdmin(true);
      setPassphrase("");
    } else {
      setPassphrase("");
    }
  }

  function lockAdmin() {
    setIsAdmin(false);
  }

  function markRead(id, value = true) {
    setMessages(prev => prev.map(m => (m.id === id ? { ...m, read: value } : m)));
  }

  function deleteMessage(id) {
    setMessages(prev => prev.filter(m => m.id !== id));
  }

  function clearAll() {
    if (!isAdmin) return;
    if (!confirm('Delete ALL messages? This cannot be undone.')) return;
    setMessages([]);
  }

  const visible = messages.filter(m => {
    if (filter === "read") return !!m.read;
    if (filter === "unread") return !m.read;
    return true;
  });

  return (
    <>
      <style>{`
        body { font-family: 'Comic Sans MS', cursive; background: repeating-linear-gradient(45deg, #ffeb3b, #ffeb3b 10px, #ff80ab 10px, #ff80ab 20px); }
        .container { padding: 20px; background: #ffffffcc; border: 5px dashed #4fc3f7; border-radius: 20px; box-shadow: 0 0 20px #00000055; }
        h1,h2,h3 { font-family: 'Comic Sans MS', cursive; color: #ff4081; text-shadow: 2px 2px #4fc3f7; }
        button { font-family: 'Comic Sans MS', cursive; background: #ff80ab; border: 3px solid #4fc3f7; padding: 10px 20px; border-radius: 15px; cursor: pointer; }
        button:hover { background: #ff4081; }
        .message-card { background: #fff59d; border: 3px dotted #f48fb1; padding: 15px; margin: 10px 0; border-radius: 15px; box-shadow: 0 0 10px #00000033; }
        .new-badge { background: #fff1f2; color: #b91c1c; padding: 2px 8px; border-radius: 999px; font-size: 11px; }
        .input, textarea, select { border: 2px solid #4fc3f7; border-radius: 8px; padding: 8px; }
      `}</style>

      <div className="min-h-screen p-6 flex items-start justify-center">
        <div className="container max-w-3xl w-full">
          <header className="flex items-center justify-between mb-6">
            <div>
              <h1 className="text-3xl font-bold">Anonymous Message Wall</h1>
              <p className="text-sm text-slate-600">People can send short anonymous notes.</p>
            </div>
            <div className="text-right">
              {isAdmin ? (
                <>
                  <div className="text-xs text-slate-600">Admin mode</div>
                  <button onClick={lockAdmin} className="mt-1 inline-block px-3 py-1 text-sm border rounded-md">Lock</button>
                </>
              ) : (
                <form onSubmit={tryUnlock} className="flex items-center gap-2">
                  <input aria-label="admin passphrase" placeholder="admin passphrase" value={passphrase} onChange={e => setPassphrase(e.target.value)} className="px-2 py-1 border rounded-md text-sm input" />
                  <button className="px-3 py-1 text-sm border rounded-md" type="submit">Unlock</button>
                </form>
              )}
            </div>
          </header>

          <main className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <section className="p-4 border rounded-lg">
              <h2 className="font-semibold mb-2">Send an anonymous message</h2>
              <form onSubmit={submitMessage} className="space-y-3">
                <div>
                  <label className="text-xs text-slate-600">Display name (optional)</label>
                  <input value={name} onChange={e => setName(e.target.value)} className="w-full px-3 py-2 border rounded-md input" placeholder={'e.g. "Anonymous"'} />
                </div>
                <div>
                  <label className="text-xs text-slate-600">Message</label>
                  <textarea value={text} onChange={e => setText(e.target.value)} className="w-full px-3 py-2 border rounded-md input" rows={5} placeholder="Write something kind, honest, or funny..." maxLength={1000000} />
                  <div className="text-xs text-slate-400 text-right">{text.length}/1000000</div>
                </div>
                <div className="flex items-center justify-between">
                  <div className="text-xs text-slate-500">Messages are anonymous.</div>
                  <button type="submit" className="px-4 py-2 bg-slate-800 text-white rounded-md">Send</button>
                </div>
              </form>
            </section>

            <section className="p-4 border rounded-lg">
              <div className="flex items-center justify-between mb-3">
                <h2 className="font-semibold">Messages</h2>
                <div className="flex items-center gap-2">
                  <select value={filter} onChange={e => setFilter(e.target.value)} className="px-2 py-1 border rounded-md text-sm select input">
                    <option value="all">All</option>
                    <option value="unread">Unread</option>
                    <option value="read">Read</option>
                  </select>
                  {isAdmin && (
                    <button onClick={clearAll} className="px-2 py-1 border rounded-md text-sm">Clear All</button>
                  )}
                </div>
              </div>

              <div className="space-y-3 max-h-[60vh] overflow-auto pr-2">
                {visible.length === 0 ? (
                  <div className="text-sm text-slate-500">No messages yet.</div>
                ) : (
                  visible.map(msg => {
                    const created = msg && msg.createdAt ? new Date(msg.createdAt).toLocaleString() : 'Unknown';
                    return (
                      <article key={msg.id} className={`p-3 rounded-lg border ${msg.read ? "bg-slate-50" : "bg-white"}`}>
                        <div className="flex items-start justify-between gap-3">
                          <div className="flex-1">
                            <div className="flex items-center gap-2">
                              <div className="text-sm font-medium">{msg.name || 'Anonymous'}</div>
                              <div className="text-xs text-slate-400">· {created}</div>
                              {!msg.read && <div className="ml-2 px-2 text-xs new-badge">New</div>}
                            </div>
                            <p className="mt-2 text-sm whitespace-pre-wrap">{msg.text}</p>
                          </div>
                          {isAdmin && (
                            <div className="flex flex-col items-end gap-2">
                              <button onClick={() => markRead(msg.id, !msg.read)} className="px-2 py-1 border rounded-md text-xs">{msg.read ? "Mark Unread" : "Mark Read"}</button>
                              <button onClick={() => { if (confirm('Delete this message?')) deleteMessage(msg.id); }} className="px-2 py-1 border rounded-md text-xs">Delete</button>
                            </div>
                          )}
                        </div>
                      </article>
                    );
                  })}
              </div>
            </section>
          </main>
        </div>
      </div>
    </>
  );
}
